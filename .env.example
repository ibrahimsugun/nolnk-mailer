# nolnk-mailer ortam değişkenleri. Bu dosyayı .env olarak kopyala ve doldur.
# .env git'e ve Docker imajına girmez.

# ---------------------------------------------------------------------------
# Sunucu
# ---------------------------------------------------------------------------
PORT=5980
# Yerelde 127.0.0.1. Docker'da compose 0.0.0.0 verir (host'a port yine açılmaz).
BIND_HOST=127.0.0.1
# Caddy/Cloudflare arkasında 1 olmalı: gerçek ziyaretçi IP'si ve Secure cookie için.
# Doğrudan internete açık bir portta 1 YAPMA, yoksa IP başlığı sahtelenebilir.
TRUST_PROXY=0
# Boş bırakılırsa data/mailer.sqlite kullanılır. Docker'da /data/mailer.sqlite.
MAILER_DB_PATH=

# ---------------------------------------------------------------------------
# Panel girişi (zorunlu; LOCAL_ONLY açık değilse bunlar olmadan sunucu başlamaz)
# ---------------------------------------------------------------------------
PANEL_USER=admin
# Şifrenin kendisi değil özeti. Üretmek için:  node scripts/hash-password.js
PANEL_PASSWORD_HASH=
# En az 32 karakter rastgele değer. Bir kez üret, sonra değiştirme (2FA anahtarı bununla
# şifreli; değişirse 2FA için kurtarma kodu ya da scripts/reset-2fa.js gerekir).
# Üretmek için:  node scripts/hash-password.js --secret
SESSION_SECRET=
# Hiç işlem yapılmazsa oturum kaç saat sonra kapansın
SESSION_IDLE_HOURS=12
# Bir oturum en fazla kaç gün yaşasın
SESSION_MAX_DAYS=7

# İsteğe bağlı: script ya da curl ile /api çağırmak için. Tanımlıysa en az 24 karakter.
# Tarayıcıdaki panel bunu kullanmaz. Gerek yoksa boş bırak.
PANEL_TOKEN=

# YALNIZ kendi bilgisayarında geliştirme için: 1 yapılırsa giriş ekranı atlanır.
# Sunucu 127.0.0.1 dışında bir adrese bağlıysa, NODE_ENV=production ya da TRUST_PROXY=1 ise
# süreç hiç başlamaz. SUNUCUDAKİ .env'e ASLA koyma.
LOCAL_ONLY=

# ---------------------------------------------------------------------------
# Resend (https://resend.com/api-keys)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=NoLnk <info@nolnk.net>
# Resend paneli > Webhooks > Add endpoint > URL: https://gonder.nolnk.net/webhooks/resend
# Events: email.bounced, email.complained. Signing secret buraya (whsec_ ile başlar).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# ---------------------------------------------------------------------------
# PrivateEmail SMTP (mail.privateemail.com: IMAP 993, SMTP 465 ya da 587, hepsi SSL)
# ---------------------------------------------------------------------------
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@nolnk.net
SMTP_PASS=uygulama-sifresi
SMTP_FROM=NoLnk <info@nolnk.net>
SMTP_HOURLY_LIMIT=450
# Kontrollü gönderim: smtp+resend TOPLAM saatlik sayaç sınırı, kayan 60 dakika (0 = sınırsız)
GLOBAL_HOURLY_LIMIT=100
